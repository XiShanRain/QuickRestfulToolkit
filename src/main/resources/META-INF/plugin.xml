<idea-plugin>
    <id>com.shenszq.restful.restfulradar</id>
    <name>RestfulRadar</name>
    <vendor email="support@example.com">shenszq</vendor>

    <description><![CDATA[
        <h3>RESTful service navigation for IntelliJ IDEA 2024.3+</h3>
        <ul>
            <li>Jump from a URL path to the matching controller method.</li>
            <li>Supports Spring MVC / Spring Boot and JAX-RS.</li>
            <li>Supports Java and Kotlin controllers without relying on fragile Kotlin internal indexes.</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>com.intellij.properties</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="com.shenszq.restful.navigation.action.GotoRequestMappingConfiguration"/>
        <postStartupActivity implementation="com.shenszq.restful.scan.RestScanStartupActivity"/>
        <notificationGroup id="RestfulRadar" displayType="BALLOON"/>
        <applicationConfigurable
                id="com.shenszq.restful.settings"
                parentId="tools"
                instance="com.shenszq.restful.settings.RestfulToolkitConfigurable"
                displayName="RestfulRadar"/>
        <toolWindow id="RestfulRadar"
                    anchor="right"
                    icon="/icons/service.png"
                    factoryClass="com.shenszq.restful.navigation.ui.RestServicesToolWindowFactory"
                    doNotActivateOnStart="true"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <actions>
        <group id="RestfulRadar.Tools" text="RestfulRadar" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="Toolkit.GotoService"
                    class="com.shenszq.restful.navigation.action.GotoRequestMappingAction"
                    text="Go to REST Service"
                    description="Jump to a REST controller method by URL"
                    icon="AllIcons.Actions.Search">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt SLASH"/>
            </action>
            <action id="Toolkit.RescanRest"
                    class="com.shenszq.restful.navigation.action.RescanRestAction"
                    text="Rescan REST Mappings"
                    description="Clear cache and re-scan all REST mappings"/>
            <action id="Toolkit.SwitchSearchUi"
                    class="com.shenszq.restful.navigation.action.SwitchRestSearchUiAction"
                    text="Switch REST Search UI (Dialog / Popup)"
                    description="Toggle the preferred REST search entry between the dialog and the ChooseByName popup">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift SLASH"/>
            </action>
            <!--
                两个独立入口动作：始终打开对话框 / 始终打开弹层，不受首选 UI 偏好影响。
                故意不写默认 <keyboard-shortcut>，避免与现有键位及 IDE 自带快捷键冲突；
                用户可在 Settings > Keymap 搜 "REST Service (Dialog)" / "(Popup)" 各自绑定。
            -->
            <action id="Toolkit.GotoServiceDialog"
                    class="com.shenszq.restful.navigation.action.OpenRestSearchDialogAction"
                    text="Go to REST Service (Dialog)"
                    description="Always open the dialog-style REST path search (project-wide)"
                    icon="AllIcons.Actions.Search"/>
            <action id="Toolkit.GotoServicePopup"
                    class="com.shenszq.restful.navigation.action.OpenRestSearchPopupAction"
                    text="Go to REST Service (Popup)"
                    description="Always open the ChooseByName popup REST path search (project-wide)"
                    icon="AllIcons.Actions.Search"/>
        </group>
    </actions>
</idea-plugin>
